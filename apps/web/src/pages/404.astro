---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container-page max-w-xl py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 font-garamond text-[40px]">This page has moved or no longer exists.</h1>
    <a href="/collections" class="btn-primary mt-8">Browse the collection</a>
  </section>
</Base>
