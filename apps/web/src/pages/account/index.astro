---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { cartCatalog } from '../../lib/cart-catalog.js';
import { INDIAN_STATES } from '../../data/india.js';
import { SITE } from '../../data/site.js';

const field = 'mt-1.5 w-full rounded-lg border border-line-strong bg-white px-3.5 py-3 text-[14px] focus:border-ink focus:outline-none';
const label = 'block text-[12px] font-medium uppercase tracking-[0.1em] text-muted';
const tab = 'whitespace-nowrap border-b-2 border-transparent px-1 pb-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-subtle transition-colors hover:text-ink aria-selected:border-ink aria-selected:text-ink';
---
<Base title="My account" noindex>
  <section class="container-page py-10 lg:py-14">
    <div id="acct-loading" class="py-20 text-center"><Icon name="progress_activity" class="mx-auto h-8 w-8 animate-spin text-gold" /></div>

    <div id="acct" class="hidden">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">My account</p>
          <h1 class="mt-2 font-garamond text-[36px] leading-tight lg:text-[44px]">Hello<span id="acct-name"></span></h1>
          <p id="acct-email" class="mt-1 text-[14px] text-muted"></p>
        </div>
        <button id="sign-out" type="button" class="btn-outline !py-2.5"><Icon name="logout" class="h-4 w-4" /> Sign out</button>
      </div>

      <div role="tablist" aria-label="Account sections" class="mt-10 flex gap-8 overflow-x-auto border-b border-line">
        <button role="tab" id="tab-orders" aria-controls="panel-orders" aria-selected="true" class={tab}>Orders</button>
        <button role="tab" id="tab-wishlist" aria-controls="panel-wishlist" aria-selected="false" class={tab}>Wishlist</button>
        <button role="tab" id="tab-profile" aria-controls="panel-profile" aria-selected="false" class={tab}>Profile</button>
      </div>

      <!-- Orders -->
      <div role="tabpanel" id="panel-orders" aria-labelledby="tab-orders" class="pt-8">
        <div id="orders-list" class="space-y-4"></div>
        <div id="orders-empty" class="hidden rounded-xl border border-dashed border-line-strong p-10 text-center">
          <Icon name="receipt_long" class="mx-auto h-8 w-8 text-gold" />
          <p class="mt-3 font-garamond text-[24px]">No orders yet</p>
          <p class="mt-1 text-[14px] text-muted">When you place an order with this email, it appears here.</p>
          <a href="/collections" class="btn-primary mt-6">Explore the collection</a>
        </div>
      </div>

      <!-- Wishlist -->
      <div role="tabpanel" id="panel-wishlist" aria-labelledby="tab-wishlist" class="hidden pt-8">
        <div id="wishlist-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4"></div>
        <div id="wishlist-empty" class="hidden rounded-xl border border-dashed border-line-strong p-10 text-center">
          <Icon name="favorite" class="mx-auto h-8 w-8 text-gold" />
          <p class="mt-3 font-garamond text-[24px]">Your wishlist is empty</p>
          <p class="mt-1 text-[14px] text-muted">Tap <span class="font-medium text-ink">Save to wishlist</span> on any piece to keep it here.</p>
          <a href="/collections" class="btn-primary mt-6">Find something you love</a>
        </div>
      </div>

      <!-- Profile -->
      <div role="tabpanel" id="panel-profile" aria-labelledby="tab-profile" class="hidden pt-8">
        <form id="profile-form" class="max-w-2xl space-y-5" novalidate>
          <p class="text-[14px] text-muted">Saved details fill in checkout for you.</p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div><label class={label} for="p-name">Full name</label><input class={field} id="p-name" name="full_name" autocomplete="name" maxlength="100" /></div>
            <div><label class={label} for="p-phone">Mobile (10 digits)</label><input class={field} id="p-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" pattern="[6-9][0-9]{9}" maxlength="10" /></div>
          </div>
          <div><label class={label} for="p-address1">Address</label><input class={field} id="p-address1" name="address1" autocomplete="address-line1" maxlength="200" /></div>
          <div><label class={label} for="p-address2">Apartment, landmark (optional)</label><input class={field} id="p-address2" name="address2" autocomplete="address-line2" maxlength="200" /></div>
          <div class="grid gap-5 sm:grid-cols-3">
            <div><label class={label} for="p-city">City</label><input class={field} id="p-city" name="city" autocomplete="address-level2" maxlength="100" /></div>
            <div><label class={label} for="p-state">State</label>
              <select class={field} id="p-state" name="state" autocomplete="address-level1"><option value="">Select</option>{INDIAN_STATES.map((s) => <option>{s}</option>)}</select>
            </div>
            <div><label class={label} for="p-pincode">PIN code</label><input class={field} id="p-pincode" name="pincode" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{5}" maxlength="6" /></div>
          </div>
          <div class="flex items-center gap-4">
            <button type="submit" class="btn-primary"><Icon name="check" class="h-4 w-4" /> <span data-label>Save details</span></button>
            <p id="profile-status" class="text-[13px]" role="status" aria-live="polite"></p>
          </div>
        </form>

        <div class="mt-16 max-w-2xl rounded-xl border border-red-200 p-6">
          <p class="font-garamond text-[22px]">Delete account</p>
          <p class="mt-1 text-[13px] leading-relaxed text-muted">Removes your sign-in, saved details and wishlist. Past orders are kept for tax records but no longer linked to you. This can't be undone.</p>
          <form id="delete-form" class="mt-4 flex flex-wrap items-center gap-3" novalidate>
            <label class="sr-only" for="delete-confirm">Type DELETE to confirm</label>
            <input id="delete-confirm" autocomplete="off" placeholder="Type DELETE to confirm" class="w-56 rounded-lg border border-line-strong px-3 py-2.5 text-[14px] focus:border-red-600 focus:outline-none" />
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-red-700 px-4 py-2.5 text-[12px] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:bg-red-800 disabled:opacity-50"><Icon name="delete" class="h-4 w-4" /> Delete</button>
            <p id="delete-status" class="w-full text-[13px] text-red-700" role="alert"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
  <script type="application/json" id="cart-catalog" set:html={JSON.stringify(await cartCatalog())} />
  <script type="application/json" id="site-config" set:html={JSON.stringify({ whatsapp: SITE.whatsapp })} />
</Base>

<script>
  import '../../scripts/account-page.js';
</script>
